---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import { links } from '../../data/site';
---

<Layout title="归档" active="archive">
  <PageHeading title="归档" english="THE ARCHIVE" description="留一个位置，慢慢整理。" />
  <section class="wrap page-content">
    <div class="empty-state">
      <span class="empty-icon">
        <Icon name="folder" size={36} />
      </span>
      <span class="eyebrow">A BLANK PAGE, FOR NOW</span>
      <h2>这里暂时还没有内容</h2>
      <p>归档正在整理中，之后再来看看吧。</p>
      <a class="text-link" href={links.playground}>
        先去广场逛逛 <Icon size={16} />
      </a>
    </div>
  </section>
</Layout>
