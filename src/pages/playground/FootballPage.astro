---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import { links } from '../../data/site';
---

<Layout title="Football Something" active="playground">
  <PageHeading title="Football Something" english="EXPLORATION / 02" parent="广场" />
  <section class="wrap page-content">
    <div class="empty-state">
      <span class="empty-icon">
        <Icon name="ball" size={42} />
      </span>
      <span class="eyebrow">WORK IN PROGRESS</span>
      <h2>这里正在建设中</h2>
      <p>足球相关的内容，之后慢慢补上。</p>
      <a class="text-link" href={links.playground}>
        返回广场 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
