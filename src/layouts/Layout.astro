---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, links } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const {
  title,
  description = 'Zonghuan Li 的个人网站。个人信息、归档，以及一些有趣的小工具。',
  active = '',
} = Astro.props;
const nav = [
  ['首页', links.home, 'home'],
  ['个人信息', links.profile, 'profile'],
  ['归档', links.archive, 'archive'],
  ['广场', links.playground, 'playground'],
  ['关于', links.about, 'about'],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} · ${site.name}` : `${site.name} · 个人网站`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳转到正文
    </a>
    <header class="site-header wrap">
      <a class="brand" href={links.home} aria-label="Zonghuan Li 首页">
        <span class="brand-mark">
          zl<span>·</span>
        </span>
        <span class="brand-name">ZONGHUAN LI</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        菜单 <span aria-hidden="true">＋</span>
      </button>
      <nav id="main-nav" aria-label="主导航">
        {nav.map(([label, href, key]) => (
          <a href={href} aria-current={active === key ? 'page' : undefined}>
            {label}
          </a>
        ))}
        <a class="nav-contact" href={links.contact}>
          联系我 <Icon size={16} />
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="footer-main">
        <div>
          <span class="eyebrow">KEEP IN TOUCH</span>
          <a class="footer-email" href={`mailto:${site.email}`}>
            {site.email}
            <Icon size={22} />
          </a>
          <p>
            在联系我之前，建议先访问<a href={links.contact}>联系方式</a>页面。
          </p>
        </div>
        <div class="footer-links">
          <a href={links.contact}>联系方式</a>
          <a href={links.about}>
            网站说明 <Icon size={14} />
          </a>
        </div>
      </div>
      <details class="footer-details">
        <summary>更多联系信息与社交媒体</summary>
        <div class="footer-detail-grid">
          <div>
            <p>手机号（中国大陆）：xxxxxxxx</p>
            <p>手机号（国际）：xxxxxxxx</p>
            <p>Email（工作）：xxxxxxxx@xxxx.com</p>
          </div>
          <div>
            <p>微信：xxxxxxxx</p>
            <p>领英：xxxxxxxx</p>
            <p>Twitter: xxxxxxxx</p>
            <p>Facebook: xxxxxxxx</p>
          </div>
        </div>
      </details>
      <div class="footer-bottom">
        <small>{site.copyright}</small>
        <span>
          一个持续生长的个人空间{' '}
          <span class="tiny-star" aria-hidden="true">
            ✳
          </span>
        </span>
        <a href="#top" class="back-top">
          回到顶部 ↑
        </a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-nav');
      const close = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('is-open');
      };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          close();
          toggle.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (
          event.target instanceof Node &&
          !document.querySelector('.site-header')?.contains(event.target)
        )
          close();
      });
    </script>
  </body>
</html>
