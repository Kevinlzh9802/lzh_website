{
  "name": "zonghuan-personal-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs build && node scripts/postbuild.mjs",
    "check": "node scripts/astro.mjs check",
    "format": "prettier --write .",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "astro": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
